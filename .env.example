# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Flipkart Delivery Address
FK_ADDRESS=Your full address here (e.g., 123 Main St, Pune, Maharashtra)

# Optional: Debug network requests containing "state"
DEBUG_NETWORK=false

# Optional: Run in headless mode (default: true)
HEADLESS=true
